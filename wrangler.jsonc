// Cloudflare configuration. Top level = local `wrangler dev`; deploy with --env staging / --env production.
// Secrets (per environment): wrangler secret put ADMIN_ACCOUNT_IDS --env <env>
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tobiyori-dev",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-assets.cjs" },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html", "/operator.html", "/api/*", "/media/*"]
  },
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TobiyoriDatabase"] }],

  "vars": { "APP_ORIGIN": "http://localhost:8787" },
  "durable_objects": { "bindings": [{ "name": "DB", "class_name": "TobiyoriDatabase" }] },
  "version_metadata": { "binding": "CF_VERSION" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tobiyori-media-dev" },
    { "binding": "BACKUPS", "bucket_name": "tobiyori-backups-dev" }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "41001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "41002", "simple": { "limit": 600, "period": 60 } }
  ],

  "env": {
    "staging": {
      "name": "tobiyori-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "tobiyori-staging.hibinoba.com", "custom_domain": true }],
      "vars": { "APP_ORIGIN": "https://tobiyori-staging.hibinoba.com" },
      "durable_objects": { "bindings": [{ "name": "DB", "class_name": "TobiyoriDatabase" }] },
      "version_metadata": { "binding": "CF_VERSION" },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tobiyori-media-staging" },
        { "binding": "BACKUPS", "bucket_name": "tobiyori-backups-staging" }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "41011", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "41012", "simple": { "limit": 600, "period": 60 } }
      ]
    },
    "production": {
      "name": "tobiyori",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "tobiyori.hibinoba.com", "custom_domain": true }],
      "vars": { "APP_ORIGIN": "https://tobiyori.hibinoba.com" },
      "durable_objects": { "bindings": [{ "name": "DB", "class_name": "TobiyoriDatabase" }] },
      "version_metadata": { "binding": "CF_VERSION" },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tobiyori-media" },
        { "binding": "BACKUPS", "bucket_name": "tobiyori-backups" }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "41021", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "41022", "simple": { "limit": 600, "period": 60 } }
      ]
    }
  }
}
