generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so role/status fields below
// are plain Strings whose allowed values are validated in the API layer
// (see src/routes/*.ts zod schemas):
//   Role: STUDENT | ORG_ADMIN | OPERATOR
//   VerifiedStatus: PENDING | APPROVED | REJECTED
//   ParticipationType: VISIT | ONE_TIME | ONGOING
//   ApplicationStatus: APPLIED | APPROVED | DECLINED | CANCELLED
//   ReportStatus: OPEN | IN_PROGRESS | RESOLVED
//   ReportTargetType: ACTIVITY | ORGANIZATION | USER | COMMUNITY
//   RiskLevel: LOW | MEDIUM | HIGH
//   CommunityMemberRole: OWNER | MEMBER

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())

  studentProfile        StudentProfile?
  organization          Organization?          @relation("OrgRepresentative")
  applications          Application[]
  reportsFiled          Report[]                @relation("ReporterUser")
  reviews               ActivityRecord[]        @relation("ReviewedByUser")
  communitiesCreated    Community[]             @relation("CommunityCreator")
  communityMemberships  CommunityMembership[]
  communityPosts        CommunityPost[]
}

model StudentProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id])
  university       String?
  interests        String // comma-separated genre tags
  bio              String?
  availableDays    String? // comma-separated: 月,火,水,木,金,土,日
  transportMethod  String? // 徒歩 | 自転車 | 車 | 電車・バス
  preferredCity    String?
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  category             String
  description          String
  verifiedStatus       String   @default("PENDING")
  insuranceInfo        String
  insuranceUpdatedAt   DateTime @default(now())
  specialBadges        String? // comma-separated tags awarded manually by the operator (e.g. 後継者育成に積極的)
  representativeUserId String   @unique
  representative       User     @relation("OrgRepresentative", fields: [representativeUserId], references: [id])
  createdAt            DateTime @default(now())

  activities Activity[]
}

model Activity {
  id                 String   @id @default(cuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id])
  title              String
  description        String
  genre              String
  city               String
  lat                Float
  lng                Float
  dateTime           DateTime
  participationTypes String   // comma-separated ParticipationType values offered
  beginnerFriendly   Boolean  @default(false)
  riskLevel          String   @default("LOW")
  insuranceCovered   Boolean  @default(false)
  capacity           Int      @default(10)
  transportNote      String?
  emergencyContact   String?
  incidentProcedure  String?
  durationMinutes    Int?
  parkingAvailable   Boolean  @default(false)
  transportCost      String?
  contactPerson      String?
  itemsToBring       String?
  photoPolicy        String?
  prohibitedNotes    String?
  isHelpRequest      Boolean  @default(false) // 「おたすけ募集」: an urgent, lightweight call for hands
  createdAt          DateTime @default(now())

  applications Application[]
}

model Application {
  id                String   @id @default(cuid())
  activityId        String
  activity          Activity @relation(fields: [activityId], references: [id])
  studentId         String
  student           User     @relation(fields: [studentId], references: [id])
  participationType String
  message           String?
  status            String   @default("APPLIED")
  createdAt         DateTime @default(now())

  record ActivityRecord?
}

model ActivityRecord {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id])
  attended          Boolean     @default(false)
  review            String?
  rating            Int? // 1-5 stars, set by the student together with the review
  certificateIssued Boolean     @default(false)
  orientationGiven  Boolean     @default(false) // org: gave newcomers an explanation beforehand
  followUpSent      Boolean     @default(false) // org: sent a thank-you / follow-up afterwards
  reviewedByUserId  String?
  reviewedByUser    User?       @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id])
  createdAt         DateTime    @default(now())
}

model Report {
  id             String   @id @default(cuid())
  reporterUserId String?
  reporter       User?    @relation("ReporterUser", fields: [reporterUserId], references: [id])
  targetType     String
  targetId       String?
  targetLabel    String
  reason         String
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
}

// A lightweight, students-only space to connect by interest / university / city —
// separate from the activity matching flow. No direct contact info is exchanged;
// members talk through in-app posts, and the operator can suspend a community.
model Community {
  id              String   @id @default(cuid())
  name            String
  description     String
  interestTag     String // free-text interest/genre keyword, e.g. "軽音楽" "国際交流"
  university      String?
  city            String?
  createdByUserId String
  createdBy       User     @relation("CommunityCreator", fields: [createdByUserId], references: [id])
  suspended       Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships CommunityMembership[]
  posts       CommunityPost[]
}

model CommunityMembership {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  @@unique([communityId, userId])
}

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime @default(now())
}
